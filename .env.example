# คัดลอกเป็น `.env.local` แล้วใส่ค่าจาก Supabase Dashboard → Project Settings → API
# ห้าม commit `.env.local` (ถูก ignore แล้ว)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ใช้เฉพาะสคริปต์โอนข้อมูล (npm run migrate:from-gas)
# ห้ามใส่คอมเมนต์หลัง key บนบรรทัดเดียวกัน (จะติดไปในค่า JWT)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ถ้าโอนจาก Google Sheets ผ่าน GAS (ไม่บังคับหลังย้ายเสร็จ)
# VITE_GAS_URL=

# ใช้เฉพาะตอน build สำหรับ GitHub Pages (local dev ไม่ต้องใส่)
# VITE_BASE_PATH=/crpao-paytrack/
